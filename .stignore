// Syncthing stignore for pi-kiro
// Sync only: dist/ (built output), package.json, tsconfig*, README, CHANGELOG, LICENSE
// Excluded: source (Git-only), dependencies, build artifacts, caches

.git
node_modules
src
test
doc
.pi
.stfolder
*.sync-conflict-*
.eslintcache
.cache
.idea
.DS_Store
logs
coverage
*.tgz
out
.env
.env.*
*.tsbuildinfo
